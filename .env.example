# Copy this file to .env.local and fill in the values.

# Google OAuth client ID. Create one at:
#   https://console.cloud.google.com/apis/credentials
# Authorize http://localhost:5173 and your production origin in the same
# project. The client ID also goes into couchdb/jwt-keys.ini as required_aud.
VITE_GOOGLE_CLIENT_ID=

# CouchDB base URL. Defaults to http://localhost:5984 if unset.
VITE_COUCHDB_URL=http://localhost:5984
