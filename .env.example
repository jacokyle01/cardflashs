# Copy this file to .env.local and fill in the values. Everything here ends
# up in the browser bundle, so nothing secret goes in this file. Server-side
# secrets for the token-exchange functions live in .dev.vars (see
# .dev.vars.example).

# Firebase web app config (Firebase console > Project settings > Your apps).
# Enable the Google sign-in provider under Authentication > Sign-in method,
# and add every origin you serve from under Authentication > Settings >
# Authorized domains (localhost is there by default).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project

# CouchDB base URL the browser syncs with. Defaults to http://localhost:5984.
VITE_COUCHDB_URL=http://localhost:5984

# Base URL of the token-exchange API. Leave empty for same-origin (/api/...),
# which is the case both in production (Pages Functions) and in dev (Vite
# proxies /api to `npm run functions`).
VITE_API_URL=
