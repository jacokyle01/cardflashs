# Copy this file to .env.local and fill in the values.

# Google OAuth client ID. Create one at:
#   https://console.cloud.google.com/apis/credentials
# Authorize http://localhost:5173 (and any other origin you serve from) under
# "Authorized JavaScript origins". The browser uses Google sign-in only to
# identify the user — JWT validation against CouchDB is currently disabled.
VITE_GOOGLE_CLIENT_ID=

# CouchDB base URL. Defaults to http://localhost:5984 if unset.
VITE_COUCHDB_URL=http://localhost:5984

# Basic-auth credentials the browser uses to talk to CouchDB. Defaults match
# the admin user in couchdb/docker-compose.yml. Dev only — these end up in the
# client bundle, so do NOT use real production credentials here.
VITE_COUCHDB_USERNAME=admin
VITE_COUCHDB_PASSWORD=admin
