; This file is generated by scripts/refresh-jwt-keys.sh.
;
; CouchDB looks up the JWT's `kid` header in the [jwt_keys] section. We pull
; Google's current OAuth signing keys (https://www.googleapis.com/oauth2/v3/certs),
; convert each JWK to a PEM, and emit a line per key with format:
;
;   rsa:<kid> = <PEM with literal \n separators>
;
; Run scripts/refresh-jwt-keys.sh to regenerate. Google rotates keys roughly
; every day, so schedule the script via cron in production.

[jwt_keys]
; rsa:abcd1234example = -----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----

[jwt_auth]
; Pin the issuer to Google. CouchDB will reject tokens with a different `iss`.
required_iss = https://accounts.google.com

; Pin the audience to your Google OAuth client ID. Replace this value with
; your VITE_GOOGLE_CLIENT_ID.
required_aud = REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
